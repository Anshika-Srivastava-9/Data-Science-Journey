    "prices=[100,200,300]\n",
    "\n",
    "discount=10 #10% discount\n",
    "final_prices =[]\n",
    "for price in prices:\n",
    "    final_price = price -(price * discount/100)\n",
    "    final_prices.append(final_price)\n",
    "\n",
    "print(final_prices)    "
